{
  "manifest_version": 3,
  "name": "LeadFox",
  "version": "2.0.0",
  "description": "Extract emails, phone numbers, and social profiles from the current page.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "action": {
    "default_title": "LeadFox",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg",
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lead-pocket@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
